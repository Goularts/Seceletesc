{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets*)"
    ],
    "ask": [
      "Edit(/docs/business-rules/**)"
    ]
  },
  "env": {
    "CLAUDE_FLOW_AUTO_UPDATE": "false",
    "RUFLO_FUNNEL": "0",
    "RUFLO_DAEMON_AUTOSTART": "0",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ferramentas/portao/sincronizar.cjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ferramentas/portao/contexto.cjs\"",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ferramentas/portao/impacto.cjs\"",
            "timeout": 15
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ferramentas/portao/verificar.cjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
