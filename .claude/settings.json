{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/docs/business-rules/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets*)"
    ],
    "ask": [
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)"
    ]
  },
  "env": {
    "CLAUDE_FLOW_AUTO_UPDATE": "false",
    "RUFLO_FUNNEL": "0",
    "RUFLO_DAEMON_AUTOSTART": "0",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  }
}
